# Copy outside the repository. This file contains paths, not secret values.
# Replace every example value before deploying. Use a reviewed shadow-mode policy first.
FLAGGUARD_IMAGE=your-registry.example/flagguard@sha256:REPLACE_WITH_VERIFIED_DIGEST
FLAGGUARD_DOMAIN=guard.example.com
FLAGSMITH_API_URL=https://flags.example.com/api/v1
PROMETHEUS_URL=http://your-private-prometheus:9090
FLAGSMITH_EXPERIMENT_ID=0
GUARDRAILS_FILE=/secure/flagguard/guardrails.yaml
OPERATOR_TOKEN_FILE=/secure/flagguard/operator-token
FLAGSMITH_TOKEN_FILE=/secure/flagguard/flagsmith-token
ENVIRONMENT_KEY_FILE=/secure/flagguard/environment-key
