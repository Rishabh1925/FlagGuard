# make init generates private local secrets into .env.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
WAREHOUSE_CREDENTIALS_SECRET=
DEMO_CONTROL_TOKEN=
# Fill these from your local Flagsmith UI. Never use a cloud/production admin token for the demo.
FLAGSMITH_ADMIN_TOKEN=
FLAGSMITH_ENV_KEY=
FLAGSMITH_SERVER_KEY=
FLAGSMITH_EXPERIMENT_ID=
WEBHOOK_URL=
DEMO_RPS=4
# Set to a tested image digest to freeze a demo environment.
FLAGSMITH_IMAGE=docker.flagsmith.com/flagsmith/flagsmith@sha256:15fa412ed49c237967ce81fdb5c899b710430c3014d5197c6b7da0095f3fb183
